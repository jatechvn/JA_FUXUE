{
  "manifest_version": 3,
  "name": "FUXUE SILENT PRO - Foxconn E-Learning Bypass",
  "version": "4.1.2",
  "description": "Tự động hóa học tập, bypass anti-pause, tự động học Video/PDF và giải đề thi trên iedu.foxconn.com",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://iedu.foxconn.com/*",
    "*://ieduapi.foxconn.com/*",
    "*://*.foxconn.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FUXUE Control Center",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://iedu.foxconn.com/*",
        "*://ieduapi.foxconn.com/*",
        "*://*.foxconn.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "icons/*"
      ],
      "matches": [
        "*://*.foxconn.com/*"
      ]
    }
  ]
}